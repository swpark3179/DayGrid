<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 생성되는 Info.plist(INFOPLIST_KEY_*)로 넣을 수 없는 배열 키만 여기에 둔다. 나머지는 project.yml에 있다.
     remote-notification: iCloud 변경 알림(조용한 푸시)을 받아 SwiftData가 동기화한다.
     CFBundleURLTypes: 잠금화면 위젯이 daygrid://recurring으로 반복 탭을 연다(AppRoute). -->
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>io.github.swpark3179.DayGrid.refresh</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.github.swpark3179.DayGrid</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>daygrid</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
